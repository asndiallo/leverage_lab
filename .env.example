# Leverage Lab — environment template.
# Copy to `.env.local` for local dev (gitignored). For prod, set these in your
# host's dashboard (e.g. Vercel), NOT in a committed file.
#
# DEV values come from the `supabase start` output (local stack).
# PROD values come from your cloud project (ouxajyznsccvewlqzidl) dashboard:
#   Settings > API  →  Project URL + publishable/anon key + secret/service_role key.

# Browser-safe (shipped to the client). Publishable/anon key is designed to be public.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Only needed for admin/service operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
